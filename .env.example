# =========================================================================
#  Online Coding Judge - environment configuration
#  Copy this file to `.env` and fill in real values.  Never commit `.env`.
# =========================================================================

# ---- Database ------------------------------------------------------------
# Local Postgres (docker compose):
#   postgresql+psycopg2://postgres:postgres@localhost:5432/online_judge
# Neon (free hosted Postgres) - copy the "psycopg2" / "SQLAlchemy" connection
# string from the Neon dashboard and KEEP the ?sslmode=require suffix:
#   postgresql+psycopg2://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Zero-setup local dev (no server needed):
#   sqlite:///./online_judge.db
DATABASE_URL=sqlite:///./online_judge.db

# ---- Security ------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated emails that are granted admin rights automatically on
# registration.  Admins are the only accounts that may create/edit/delete
# problems, test cases and contests.
# Note: reserved TLDs such as .local and .invalid are rejected by the email
# validator, so use a real domain here.
ADMIN_EMAILS=admin@example.com

# ---- Application ---------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list, or * to allow any origin.
CORS_ORIGINS=*

# ---- Execution engine ----------------------------------------------------
# auto   -> use Docker if the daemon is reachable, else the local sandbox
# docker -> force the Docker sandbox (fails loudly if unavailable)
# local  -> force the rlimit-based subprocess sandbox
EXECUTION_BACKEND=auto

# Default resource ceilings (a problem may override the time limit).
EXECUTION_TIME_LIMIT_MS=2000
EXECUTION_MEMORY_LIMIT_MB=128
EXECUTION_CPU_QUOTA_PERCENT=50
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_PIDS_LIMIT=64

# Staging directory for sandbox scratch space. Leave empty to use the system
# temp directory. Set it ONLY when the API runs inside a container that talks
# to the host Docker socket, and bind-mount the same absolute path on both
# sides (docker-compose.yml already does this).
EXECUTION_WORKDIR=
